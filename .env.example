# Copy this file to .env and fill in real values. .env is git-ignored and must
# never be committed. In production, prefer real environment variables / a
# secrets manager over a .env file on disk.

# REQUIRED. A long random string. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-50+-char-random-value

# Keep False everywhere except local debugging. Defaults to False if unset.
DEBUG=False

# Comma-separated hostnames this site will serve. Required when DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1

# Database. Default (unset) is local SQLite. To use Postgres, just set:
#   DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_URL=postgres://app:secret@localhost:5432/appdb

# --- Transport security toggles ---
# These default to the secure value. Set SECURE_SSL_REDIRECT=False ONLY for
# local HTTP development where you have no TLS terminator in front of Django.
# SECURE_SSL_REDIRECT=True

# Set True when Django sits behind a TLS-terminating proxy/load balancer that
# sets the X-Forwarded-Proto header. Leave False if Django terminates TLS
# itself or for local dev.
# USE_X_FORWARDED_PROTO=False

# HSTS max-age in seconds (default 31536000 = 1 year). Set to 0 locally if you
# need to reach the site over plain HTTP after testing HTTPS.
# SECURE_HSTS_SECONDS=31536000
